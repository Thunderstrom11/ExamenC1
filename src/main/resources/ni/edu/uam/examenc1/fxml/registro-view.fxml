<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER" prefHeight="76.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Registro Empleados">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <GridPane BorderPane.alignment="CENTER">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="30.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="0.0" prefWidth="300.0">
                     <children>
                        <TextField fx:id="txtNombre" promptText="nombre" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="10.0" layoutY="10.0" prefHeight="0.0" prefWidth="300.0">
                     <children>
                        <TextField fx:id="txtApellidos" promptText="apellidos" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="30.0" GridPane.columnIndex="1">
               <children>
                  <HBox alignment="CENTER" prefHeight="0.0" prefWidth="300.0">
                     <children>
                        <TextField fx:id="txtCargo" promptText="cargo" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="1.0" prefWidth="300.0">
                     <children>
                        <TextField fx:id="txtSalario" promptText="Salario (C$)" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0" GridPane.rowIndex="1">
               <children>
                  <Button fx:id="btnSalir" mnemonicParsing="false" text="Salir" />
                  <Button fx:id="btnGuardar" mnemonicParsing="false" text="Guardar" />
               </children>
            </HBox>
         </children>
      </GridPane>
   </center>
</BorderPane>
